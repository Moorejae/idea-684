# ── LLM Backend: Qwen via Hugging Face (NO Gemini keys) ──

# Tier 1: Self-hosted Qwen Space (free, no token needed).
# OpenAI-compatible endpoint at /v1/chat/completions.
LLM_ENDPOINT=https://slymun-forchi.hf.space
LLM_MODEL=qwen2.5-7b

# Tier 2: HF Router fallback with stronger open models (Qwen3-32B, etc.).
HF_TOKEN=your_huggingface_access_token_here

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
