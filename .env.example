# ── LLM Backend: Gemini primary, Qwen 2.5 7B fallback ──

# Tier 1 (primary): Gemini API keys, comma-separated. Provider round-robins the
# pool and walks the model waterfall below (falls through on rate limit). Fast
# gemini flash models first; slow thinking gemma models last:
#   gemini-3.5-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.1-flash-lite,
#   gemma-4-31b-it, gemma-4-26b-a4b-it
GEMINI_API_KEY_POOL=key1,key2,key3
# (A single key can also be set via GEMINI_API_KEY — the provider falls back to it.)

# Tier 2: Self-hosted Qwen Space (free, no token needed).
# OpenAI-compatible endpoint at /v1/chat/completions.
LLM_ENDPOINT=https://slymun-forchi.hf.space
LLM_MODEL=qwen2.5-7b

# Tier 3: HF Router fallback with stronger open models (Qwen3-32B, etc.).
HF_TOKEN=your_huggingface_access_token_here

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
